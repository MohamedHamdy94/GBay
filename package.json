{
  "name": "gbay",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace @gbay/api run dev",
    "build:api": "npm --workspace @gbay/api run build",
    "test:api": "npm --workspace @gbay/api run test",
    "db:generate": "npm --workspace @gbay/database run generate",
    "db:migrate": "npm --workspace @gbay/database run migrate",
    "db:migrate:sql": "npm --workspace @gbay/database run migrate:sql"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "bullmq": "^5.77.6",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.3"
  }
}
